# Конфигурация для тестового сервера Сбера (скопируйте в server.env и заполните)
# Файл server.env добавлен в .gitignore и не попадает в репозиторий.

# 1. Параметры подключения к серверу
# user@host для ssh и scp (например, deploy@192-0-2-1.sslip.io)
SERVER=deploy@mytpu.<ip-через-дефисы>.sslip.io

# Каталог стенда на сервере — от домашнего каталога, без «~» (иначе раскроется на ПК)
REMOTE_DIR=mytpu

# 2. Публичные адреса и Caddy
# Публичный домен стенда (сайт Caddy с сертификатом Let's Encrypt)
MYTPU_HOST=mytpu.<ip-через-дефисы>.sslip.io

# Публичный адрес шлюза
GATEWAY_PUBLIC_URL=https://${MYTPU_HOST}

# 3. Интеграция с ml-server
# Публичный HTTPS-адрес ml-server через системный Caddy (loopback хоста недоступен из контейнера)
ML_BASE_URL=https://<домен-ml-server>/v1
ML_CHAT_MODEL=tpu-assistant

# 4. Сеть и доверенные прокси
# Фиксированная подсеть для сети edge в Docker Compose
EDGE_SUBNET=172.31.240.0/24
# Подсеть внутренней сети core (assistant → gateway); её же указывают в --networks ключа chat.service
CORE_SUBNET=172.31.241.0/24

# Адрес шлюза сети edge — с него приходят запросы от Caddy и SSH-туннеля к 127.0.0.1:8081
TRUSTED_PROXIES=172.31.240.1/32

# 5. Локальные пути на ПК (для скриптов pack.sh и upload.sh)
# Каталог с моделью векторов e5 (ONNX)
MODEL_DIR=D:/models/e5-small-en-ru-int8

# Каталог с корпусом документов (содержит help-tpu.json и tpu-site.jsonl)
DATASET_DIR=<путь к папке с help-tpu.json и tpu-site.jsonl>

# Путь к локальному файлу базы стран (CC BY 4.0 DB-IP)
GEO_DB=D:/geo/dbip-country-lite.mmdb

# Локальный каталог для сохранения архива образов Docker перед отправкой
PACK_DIR=/d/claude-tmp/mytpu-pack

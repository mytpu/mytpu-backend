# Параметры стенда «Мой ТПУ» на сервере ТПУ. Копия этого файла — /etc/mytpu/server.env (0600, владелец root):
# секретов здесь нет, они лежат файлами в /etc/mytpu/secrets/. Значения с пробелами — в кавычках: файл читает
# и bash (render-caddyfile.sh), и docker compose --env-file.

# --- Адреса и HTTPS ---
MYTPU_HOST=mytpu.red.tpu.ru
GATEWAY_PUBLIC_URL=https://mytpu.red.tpu.ru

# Где завершается HTTPS для mytpu.red.tpu.ru:
#   upstream    — на входном прокси ТПУ; Caddy слушает loopback (MYTPU_LISTEN), клиентский адрес Caddy не видит
#   caddy-cert  — сертификат ТПУ отдаётся Caddy (MYTPU_TLS_CERT и MYTPU_TLS_KEY, только чтение для пользователя caddy)
#   letsencrypt — домен указывает на этот сервер, открыты 80/443, Caddy берёт сертификат сам
MYTPU_TLS=upstream
MYTPU_LISTEN=127.0.0.1:8443
MYTPU_TLS_CERT=/etc/mytpu/tls/fullchain.pem
MYTPU_TLS_KEY=/etc/mytpu/tls/privkey.pem

# --- Консоль администратора ---
# Сети администраторов ТПУ, которым открыты /console/* и /admin/api/*. Пусто — оба маршрута отвечают 404
# (безопасное начальное состояние). В режиме upstream здесь адрес входного прокси: клиентский адрес до Caddy
# не доходит, поэтому ограничение по сетям делает входной прокси, а Caddy закрывает маршрут от всех остальных.
CONSOLE_ALLOWED_NETWORKS=""
# Каталог со статикой консоли: его целиком заменяет mytpu-update.sh при переключении версии
MYTPU_CONSOLE_ROOT=/var/lib/mytpu/console

# --- Канал релизов GitHub ---
MYTPU_REPO=mytpu/mytpu-backend
# latest — последний опубликованный релиз; иначе тег (например v20261125-742d583)
MYTPU_CHANNEL=latest
GHCR_REGISTRY=ghcr.io
# Пользователь GHCR для docker login; пароль (PAT только на чтение пакетов) — /etc/mytpu/secrets/github_token
GHCR_USER=

# --- Compose ---
MYTPU_PROJECT=mytpu
# Тома с данными: имена постоянные, чтобы пережить переустановку, смену каталога и откат образов
MYTPU_PGDATA_VOLUME=mytpu-pgdata
MYTPU_RAG_FILES_VOLUME=mytpu-rag-files
# Версия PostgreSQL не меняется обновлением: миграция БД — отдельная процедура (README.md)
POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17
MYTPU_CONFIG_DIR=/etc/mytpu
EDGE_SUBNET=172.31.240.0/24
CORE_SUBNET=172.31.241.0/24
# Адрес шлюза сети edge: с него приходят соединения с хоста (Caddy, SSH-туннель, curl на 18090)
TRUSTED_PROXIES=172.31.240.1/32
EDGE_GATEWAY=172.31.240.1
# Кому открыт порт консоли шлюза 127.0.0.1:18090 (сравнивается адрес соединения, не заголовок)
ADMIN_ALLOWED_NETWORKS=172.31.240.1/32
V1_KEYS_UNTIL=2026-10-01

# --- Внешние сервисы и данные на диске ---
ML_BASE_URL=https://ml.example.tpu.ru/v1
ML_CHAT_MODEL=tpu-assistant
# Каталог модели векторов e5 (ONNX) — кладётся один раз, в релиз не входит
RAG_MODEL_HOST_DIR=/var/lib/mytpu/models/e5-small-en-ru-int8
# База стран для ключей «только РФ» (DB-IP Country Lite)
GEO_DB_HOST_DIR=/var/lib/mytpu/geo
# Корпус для разового ingest (профиль ingest)
RAG_DATASET_HOST_DIR=/var/lib/mytpu/dataset

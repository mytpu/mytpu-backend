<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>org.mytpu</groupId>
    <artifactId>my-tpu-backend</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <!-- Boot 4.1.1 тянет Tomcat 11.0.24 с критичными CVE-2026-65182/65905/68525 (trivy); убрать, когда Boot обновится -->
        <tomcat.version>11.0.27</tomcat.version>
        <!-- Boot 4.1.1 тянет jackson 2.21.5 / 3.1.5 с уязвимостями HIGH (GHSA-7hhh-6rmp-j9qf, GHSA-cxp5-3px4-pw24 и др., OSV);
             последние патчи той же линии; убрать, когда Boot обновится -->
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <!-- jsoup — в gateway (расписание) и rag-search (разбор HTML); 1.22.1 — GHSA-65r4-943x-97jj (HIGH) -->
        <jsoup.version>1.24.1</jsoup.version>
    </properties>

    <modules>
        <module>shared</module>
        <module>services</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- SBOM (CycloneDX) по всему реактору: mvn -Psbom package → target/bom.json, target/bom.xml. Отдельный профиль,
             чтобы обычный verify не тратил время на разбор зависимостей; в CI включён (ci-build.yml) -->
        <profile>
            <id>sbom</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <executions>
                            <!-- Запуск из pluginManagement Spring Boot (SBOM внутрь каждого jar) не нужен: выгружается один общий -->
                            <execution>
                                <id>default</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>aggregate-sbom</id>
                                <inherited>false</inherited>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <outputFormat>all</outputFormat>
                            <outputName>bom</outputName>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
